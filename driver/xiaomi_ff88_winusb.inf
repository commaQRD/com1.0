; Xiaomi factory USB 2717:FF88 -> WinUSB
; Use only if FDT opens the device via libusb, not as a COM port.
; Unsigned. Zadig -> WinUSB is usually easier on Windows 10/11.

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ManufacturerName%
DriverVer   = 09/12/2026,1.0.0.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = DeviceList,NTamd64,NTarm64

[DeviceList.NTamd64]
%DeviceName% = USB_Install, USB\VID_2717&PID_FF88
%DeviceName% = USB_Install, USB\VID_2717&PID_FF88&REV_0100

[DeviceList.NTarm64]
%DeviceName% = USB_Install, USB\VID_2717&PID_FF88
%DeviceName% = USB_Install, USB\VID_2717&PID_FF88&REV_0100

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[USB_Install.HW]
AddReg = USB_Install.HW.AddReg

[USB_Install.HW.AddReg]
HKR,,DeviceInterfaceGUIDs,0x00010000,"{A5DCBF10-6530-11D2-901F-00C04FB951ED}"

[Strings]
ManufacturerName = "Xiaomi Inc."
DeviceName      = "Xiaomi Factory USB (2717:FF88 WinUSB)"
